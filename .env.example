# Copy to .env and set values for local development
# MODEL: name of the Ollama or LLM model to use
MODEL=qwen2.5:3b-instruct
VOICE_ENABLED=true
VOICE_GENDER=female
VOICE_STYLE=casual
VOICE_RATE=200

# --- Hybrid Backend (Local/Cloud) ---
# Default provider: "local" (Ollama) or "cloud" (Groq)
ROHA_PROVIDER=local
# Local Ollama settings
LOCAL_MODEL=qwen2.5:3b-instruct
LOCAL_BASE_URL=http://localhost:11434/v1
# Cloud Groq settings (get key at https://console.groq.com)
GROQ_API_KEY=
CLOUD_MODEL=qwen/qwen3.8-27b